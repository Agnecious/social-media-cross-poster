# =============================================================================
# Backend configuration (READ FROM ENV — nothing is persisted anywhere)
# Copy this file to `.env` and fill in the values you obtain from each
# platform's developer portal. Leave a platform's block empty to disable it.
# =============================================================================

# --- Server ---
PORT=3000
# The Angular dev server origin, used for CORS.
# IMPORTANT: this must match the origin you open the app on — OAuth connect
# posts the result back to this exact origin. A mismatch (e.g. app on :4200 but
# this set to :8080) makes the connect popup silently do nothing.
FRONTEND_ORIGIN=http://localhost:4200
# Log verbosity: error | warn | info | debug (default info). Logs are JSON
# lines on stdout/stderr — capture with your process manager, or e.g.
# `npm start > app.log 2>&1`.
LOG_LEVEL=info
# App version shown in /api/health and the admin System status panel (e.g. a
# git tag or release number). Defaults to 'dev' if unset.
APP_VERSION=dev
# Optional error-tracking DSN. When set, captured exceptions are forwarded to
# your tracker (requires wiring @sentry/node — see services/monitoring.js).
# Leave blank to just log exceptions (the default, dependency-free behaviour).
SENTRY_DSN=
# Timeout (ms) for the backend's outbound calls to platform APIs (default 15000).
# Prevents a stalled call (e.g. blocked by corporate SSL inspection) from
# hanging an OAuth popup forever — it fails fast with a logged error instead.
# (Large media uploads override this and run without a timeout.)
HTTP_TIMEOUT_MS=15000
# Max accounts a user can connect PER platform. Default 5. Set 0 for unlimited.
# (Global ceiling; per-plan caps below take precedence — see feature gating.)
MAX_ACCOUNTS_PER_PLATFORM=5
# Max size (in MB) for a single uploaded image/video. Default 100.
# Oversize uploads are rejected with HTTP 413.
MAX_UPLOAD_MB=100

# App-wide UI theme the frontend ships in: light | dark (default light).
# Applies to the whole app including the landing page. No per-user toggle —
# change this and restart the backend to switch.
APP_THEME=light

# Support inbox — where customers' "Contact support" emails are addressed.
# Used by the in-app "Contact support" action.
SUPPORT_EMAIL=mathema.business@gmail.com

# SMTP for sending support emails directly from the server (OPTIONAL).
# If these are blank, the app falls back to opening the customer's own mail
# client via a mailto: link (zero config). Fill them in to send server-side.
# Gmail setup: enable 2-Step Verification, create an App Password, then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=mathema.business@gmail.com
#   SMTP_PASS=<the 16-char app password>
#   SMTP_FROM=mathema.business@gmail.com   # optional; defaults to SMTP_USER
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Subscription plans (prices in South African Rand, ZAR) ---
# Monthly price per tier. Change any of these to update pricing everywhere
# (pricing page + Plan screen) with no rebuild. Blank = "custom / contact us".
# If unset/invalid, the app falls back to sensible defaults (169 / 529 / 1399).
PLAN_STARTER_PRICE_ZAR=169
PLAN_PRO_PRICE_ZAR=529
PLAN_AGENCY_PRICE_ZAR=1399
# Free-trial length in days (default 30).
TRIAL_DAYS=30
# Max successful cross-posts allowed during the trial (default 1). One compose
# → fan-out to several platforms counts as ONE.
TRIAL_MAX_POSTS=1
# Max social accounts PER PLATFORM each tier may connect (0 = unlimited).
# These are the ENFORCED plan limits (feature gating). Change to tune
# entitlements with no rebuild. If unset, the tier default is used (1 / 5 / 0).
PLAN_STARTER_MAX_ACCOUNTS=1
PLAN_PRO_MAX_ACCOUNTS=5
PLAN_AGENCY_MAX_ACCOUNTS=0

# --- Billing (subscriptions) ---
# Master switch. When false (default), billing is inert: new customers get the
# old immediate trial and no payment is required. When true, new signups must
# choose a plan + add billing before access (trial starts after setup).
BILLING_ENABLED=false
# Which provider adapter to use: mock | peach | paystack. 'mock' charges NO
# real money and is for testing the full subscribe → webhook → state flow.
BILLING_PROVIDER=mock
# Shared secret for mock/peach webhooks (X-Billing-Signature). Paystack does NOT
# use this — it signs webhooks with your PAYSTACK_SECRET_KEY instead.
BILLING_WEBHOOK_SECRET=
# Peach Payments REST credentials (only used when BILLING_PROVIDER=peach).
PEACH_ENTITY_ID=
PEACH_ACCESS_TOKEN=
PEACH_BASE_URL=https://testapi.peachpayments.com
# Paystack credentials (only used when BILLING_PROVIDER=paystack).
# From the Paystack dashboard → Settings → API Keys & Webhooks. Use the TEST
# keys (sk_test_... / pk_test_...) in dev, LIVE keys in production. The SECRET
# key authorises API calls AND signs inbound webhooks (HMAC-SHA512) — keep it
# backend-only, never expose it. Register your webhook URL in that same screen:
#   https://<your-domain>/api/billing/webhook   (event: charge.success etc.)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Charge currency (ZAR | NGN | GHS | USD | KES …). Must be enabled on your
# Paystack account. Defaults to ZAR.
PAYSTACK_CURRENCY=ZAR

# --- AI Content Assistant ---
# Turns one idea into platform-optimized content, rewrites, hashtags, titles
# and translations. Two providers in a primary -> fallback chain: Google Gemini
# is tried first, OpenRouter is used only if Gemini is unconfigured or fails.
# Master switch. When false, the AI endpoints return 503 and the UI hides it.
AI_ENABLED=false
# PRIMARY: Google Gemini. Get a key at https://aistudio.google.com/app/apikey
# (free tier available). Model defaults to the fast/cheap gemini-1.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# FALLBACK: OpenRouter (https://openrouter.ai/keys). An OpenAI-compatible
# gateway to many models; used only when Gemini can't answer. Pick any model
# slug from openrouter.ai/models (e.g. openai/gpt-4o-mini, meta-llama/...).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Which plans include the AI assistant (true/false; also accepts 1/0, yes/no).
# Defaults: Starter OFF, Pro + Agency ON. Starter customers get an upgrade prompt.
PLAN_STARTER_AI=false
PLAN_PRO_AI=true
PLAN_AGENCY_AI=true

# --- Supabase (database + customer auth) — for the multi-tenant SaaS build ---
# Create a project at supabase.com (a separate one for dev and prod).
# From Project Settings → Database (copy BOTH connection strings):
#   DATABASE_URL = pooled connection (Transaction mode, port 6543) — used by the app
#   DIRECT_URL   = direct connection (port 5432) — used by Prisma migrations
DATABASE_URL=
DIRECT_URL=
# From Project Settings → API:
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role is SECRET — backend only, never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Administrator login (protects the Admin config screen) ---
# The username you log in with.
ADMIN_USERNAME=admin
# A bcrypt hash of your password — NEVER put a plaintext password here.
# Generate your own with:  npm run hash-password -- "your-password"
# (The value below is a placeholder, NOT a working hash — replace it.)
ADMIN_PASSWORD_HASH=REPLACE_WITH_YOUR_OWN_BCRYPT_HASH
# A long random string used to sign login tokens. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# How long a login stays valid.
ADMIN_TOKEN_TTL=8h

# --- Connection persistence (optional) ---
# If set, OAuth tokens are saved ENCRYPTED to a local file (.tokens.enc) so
# connections survive restarts. Leave blank to keep tokens in-session only.
# Use a long random string. This is the app's one deliberate exception to
# "store nothing" — only auth tokens are persisted, and they're encrypted.
TOKEN_STORE_KEY=

# -----------------------------------------------------------------------------
# FACEBOOK (Graph API)  — https://developers.facebook.com
# Posts text/photo/video to a Facebook Page.
# -----------------------------------------------------------------------------
FACEBOOK_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback
# Add read_insights to enable per-page Analytics.
FACEBOOK_SCOPES=pages_manage_posts,pages_read_engagement,pages_show_list,read_insights
FACEBOOK_API_VERSION=v21.0

# -----------------------------------------------------------------------------
# INSTAGRAM (Graph API)  — https://developers.facebook.com
# Requires a Business/Creator account linked to a Facebook Page.
# Media must be reachable at a public URL (two-step publish).
# -----------------------------------------------------------------------------
INSTAGRAM_ENABLED=false
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# Add instagram_manage_insights to enable Instagram Analytics.
INSTAGRAM_SCOPES=instagram_basic,instagram_content_publish,pages_show_list,instagram_manage_insights
INSTAGRAM_API_VERSION=v21.0

# -----------------------------------------------------------------------------
# YOUTUBE (Data API v3)  — https://console.cloud.google.com
# Video only. Enable "YouTube Data API v3" and create OAuth credentials.
# -----------------------------------------------------------------------------
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
# Add yt-analytics.readonly to enable channel Analytics.
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/yt-analytics.readonly

# -----------------------------------------------------------------------------
# TIKTOK (Content Posting API)  — https://developers.tiktok.com
# Requires app review/approval before production posting.
# -----------------------------------------------------------------------------
TIKTOK_ENABLED=false
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback
TIKTOK_SCOPES=video.publish,video.upload
