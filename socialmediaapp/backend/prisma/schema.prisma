// Prisma schema for the multi-tenant SaaS.
// Provider is PostgreSQL (Supabase). DATABASE_URL is the pooled connection
// (used by the app); DIRECT_URL is the direct connection (used for migrations).

generator client {
  provider = "prisma-client-js"
  // Cross-platform query-engine binaries. "native" = whatever machine runs
  // `prisma generate`; the explicit targets make the generated client portable
  // across the team's machines + the Docker image without regenerating:
  //   darwin        = Intel Mac
  //   darwin-arm64  = Apple Silicon (M1/M2/M3)
  //   windows       = Windows
  //   debian-openssl-3.0.x = the Linux container (node:* Debian-based image)
  // If you copy node_modules between OSes, run `npm run prisma:generate` once
  // on each OS (or keep all targets here and generate once per OS).
  binaryTargets = ["native", "darwin", "darwin-arm64", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One customer (tenant). When using Supabase Auth, `id` mirrors the Supabase
/// auth user id (a UUID). Everything a customer owns references this id.
model Customer {
  id         String   @id // matches Supabase auth.users.id (UUID)
  email      String   @unique
  // Profile captured at sign-up (required in the UI; nullable here so existing
  // rows and the pre-confirmation window don't break). Mirrored from the
  // Supabase user's metadata on first authenticated request.
  firstName  String?  @map("first_name")
  lastName   String?  @map("last_name")
  phone      String?
  plan       String   @default("starter") // starter | pro | agency (chosen tier)
  planStatus String   @default("active") @map("plan_status")
  // Trial window end (set when billing setup completes and the trial begins).
  trialEndsAt        DateTime? @map("trial_ends_at")
  // Billing lifecycle. NEW customers start at 'pending_setup' — they must
  // choose a plan + add billing before any access. Then:
  //   pending_setup -> trialing -> active | past_due | canceled
  subscriptionStatus String    @default("pending_setup") @map("subscription_status")
  // Count of successful cross-posts made during the trial (cap enforced by
  // TRIAL_MAX_POSTS). A single compose -> fan-out counts as one.
  trialPostsUsed Int @default(0) @map("trial_posts_used")
  createdAt  DateTime @default(now()) @map("created_at")

  connectedAccounts ConnectedAccount[]
  posts             Post[]
  usageEvents       UsageEvent[]
  subscription      Subscription?

  @@map("customers")
}

/// A customer's billing subscription. One per customer (the current one).
/// Driven by provider webhooks — the app never charges cards directly.
model Subscription {
  id                     String    @id @default(uuid())
  customerId             String    @unique @map("customer_id")
  provider               String // mock | peach | paystack
  providerSubscriptionId String?   @map("provider_subscription_id") // e.g. Paystack subscription_code
  providerCustomerId     String?   @map("provider_customer_id")
  // Provider token needed to manage the subscription (e.g. Paystack's email
  // token, required alongside the subscription code to cancel/disable).
  providerToken          String?   @map("provider_token")
  plan                   String // starter | pro | agency
  status                 String // pending | trialing | active | past_due | canceled
  currentPeriodEnd       DateTime? @map("current_period_end")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@map("subscriptions")
}

/// Raw provider webhook events, stored for idempotency + audit. The unique
/// (provider, eventId) prevents processing the same event twice.
model PaymentEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String   @map("event_id")
  type        String // e.g. payment.succeeded | subscription.canceled
  customerId  String?  @map("customer_id")
  payload     String? // JSON string of the (non-sensitive) event body
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([customerId])
  @@map("payment_events")
}

/// A connected social account (login) belonging to a customer. Replaces the
/// global .tokens.enc file. `authEnc` holds the AES-encrypted OAuth token.
model ConnectedAccount {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  platform   String
  accountId  String   @map("account_id")
  label      String
  authEnc    String   @map("auth_enc") // AES-256-GCM encrypted token JSON
  scopes     String?
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, platform, accountId])
  @@index([customerId])
  @@map("connected_accounts")
}

/// Activity/history: a record of each publish or schedule attempt.
model Post {
  id          String    @id @default(uuid())
  customerId  String    @map("customer_id")
  platform    String
  accountId   String    @map("account_id")
  text        String?
  mediaType   String    @map("media_type") // none | image | video
  scheduledAt DateTime? @map("scheduled_at")
  status      String // published | scheduled | failed
  resultUrl   String?   @map("result_url")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("posts")
}

/// Cached analytics metrics per customer, so we don't hit platform APIs on
/// every view. One row per metric per fetch.
model AnalyticsSnapshot {
  id                 String   @id @default(uuid())
  customerId         String   @map("customer_id")
  connectedAccountId String?  @map("connected_account_id")
  metric             String // e.g. "facebook:page_impressions"
  value              Float
  periodStart        DateTime @map("period_start")
  periodEnd          DateTime @map("period_end")
  fetchedAt          DateTime @default(now()) @map("fetched_at")

  @@index([customerId])
  @@map("analytics_snapshots")
}

/// Lightweight usage/analytics events (built-in traffic counter + product usage).
/// customerId is null for anonymous events like public page views.
model UsageEvent {
  id         String   @id @default(uuid())
  customerId String?  @map("customer_id")
  type       String // pageview | login | signup | publish | schedule
  path       String?
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([createdAt])
  @@map("usage_events")
}

/// Audit trail of sensitive, deliberate actions (who did what, when). Kept
/// deliberately standalone (no FK to Customer) so the record survives even if
/// the referenced customer/account is later deleted — an audit log must outlive
/// the things it references. `metadata` holds a small JSON blob of extra detail
/// (e.g. before/after plan). Never store secrets here.
model AuditLog {
  id         String   @id @default(uuid())
  actorType  String   @map("actor_type") // admin | customer | system
  actorId    String?  @map("actor_id") // admin username, customer id, or null
  // Human-readable label for the actor (customer email, admin username),
  // captured at write time so the trail stays readable even if the customer
  // is later deleted.
  actorLabel String?  @map("actor_label")
  action     String // e.g. admin.config.update | customer.plan.change | account.connect
  targetType String?  @map("target_type") // platform | customer | account
  targetId   String?  @map("target_id")
  // Human-readable label for the target (e.g. the affected customer's email,
  // the platform name), captured at write time for at-a-glance readability.
  targetLabel String? @map("target_label")
  metadata   String? // JSON string of extra, non-sensitive detail
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorType])
  @@index([action])
  @@map("audit_logs")
}
